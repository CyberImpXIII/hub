#!/usr/bin/env node
'use strict';
// `hub --help`. The program is src/; this file only runs it.
const { main } = require('../src/cli');

main(process.argv.slice(2)).then((code) => {
  if (code !== null) process.exitCode = code;
}, (e) => {
  process.stderr.write(`hub: ${e && e.stack ? e.stack : e}\n`);
  process.exitCode = 1;
});
